DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_trip_optimizer
JWT_SECRET=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint. For Gemini's free tier use
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ with
# OPENAI_MODEL=gemini-3.5-flash-lite and a Gemini API key as OPENAI_API_KEY.
# (gemini-2.5-flash is closed to new keys, and gemini-3.8-flash allows only 20 free requests a day.)
# Leave both empty for OpenAI's API and gpt-4o-mini.
OPENAI_BASE_URL=
OPENAI_MODEL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Real flight fares (free): https://www.travelpayouts.com -> Profile -> API token
TRAVELPAYOUTS_TOKEN=
# Live hotel prices (Google Hotels): free SerpApi key, no card (https://serpapi.com -> Dashboard -> API key).
# Leave empty and hotel prices show as unavailable.
SERPAPI_API_KEY=
# Sign in with Google: the Web client ID from Google Cloud (Google Auth Platform -> Clients).
# Only the ID is needed, no client secret. Set the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID for
# the frontend; leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
